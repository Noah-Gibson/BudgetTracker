# Google OAuth (Google Cloud console)
AUTH_SECRET=generate-a-32-byte-secret
NEXTAUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Neon Postgres
DATABASE_URL=

# A random 32+ byte server-only value used to make database ownership handles opaque.
AUTH_OWNER_PEPPER=

# The full deployed URL, e.g. https://budget.example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
